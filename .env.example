# Copy to .env locally. In production, use your host's secret settings.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
PUBLIC_ORIGIN=http://localhost:3001

# Leave disabled until you configure your Razorpay TEST account.
PAYMENTS_ENABLED=false
PAYMENT_ENVIRONMENT=test
# Essential annual price in RUPEES. Edit this value, then restart the server.
ESSENTIAL_PRICE_INR=11870
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

MERCHANT_NAME=Tootica
PAYMENT_DESCRIPTION=Tootica Essential annual plan (1 year)
AGREEMENT_VERSION=client-agreement-v1

# Transactional SMTP delivery (server only). Sender must be a plain email address.
EMAIL_ENABLED=false
EMAIL_ALLOW_TEST=false
EMAIL_FROM=noreply@tootica.com
EMAIL_REPLY_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
INVOICE_COMPANY_ADDRESS=
INVOICE_TAX_ID=
# Optional external Unicode TTF font for invoices; keep outside dist.
INVOICE_FONT_PATH=


# Required durable storage: private Google Sheet via signed Apps Script requests.
# See deploy/GOOGLE-SHEETS-SETUP.md. No database or service-account file is needed.
SHEETS_STORE_URL=
SHEETS_STORE_SECRET=

# Enable only after deploying the updated Code.gs and generated State.gs.
INVITATIONS_REQUIRED=false
# Private admin access key, at least 32 random characters; mark secret in Netlify.
INVITATION_ADMIN_KEY=
